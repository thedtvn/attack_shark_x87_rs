"""Type stubs for the compiled extension `ask87._native`.

This is the low-level layer; use the typed API in `ask87` instead.
"""

from typing import Callable, Optional

ActionDict = dict[str, object]
EventTuple = tuple[str, int, bool, int]
MacroTuple = tuple[str, list[EventTuple]]
Rect = tuple[int, int, int, int]
Rgb = tuple[int, int, int]

class X87Error(Exception): ...
class NotFoundError(X87Error): ...
class DeviceError(X87Error): ...
class AsleepError(X87Error): ...

def key_table() -> list[tuple[str, str, int, Rect]]: ...
def group_table() -> list[tuple[str, bool, list[list[str]], Rect]]: ...
def layout_table() -> list[list[str]]: ...
def effect_table() -> list[tuple[str, int]]: ...
def controller_table() -> list[tuple[str, str, str, bool]]: ...
def image_size() -> tuple[int, int]: ...
def encode_action(action: ActionDict) -> int: ...
def decode_action(word: int) -> ActionDict: ...
def validate_macros(macros: list[MacroTuple]) -> int: ...
def key_at(x: int, y: int) -> Optional[str]: ...
def group_at(x: int, y: int) -> Optional[str]: ...
def key_neighbour(name: str, direction: str) -> Optional[str]: ...
def group_of(name: str) -> tuple[str, str, int]: ...
def group_rect(name: str) -> Rect: ...
def version() -> str: ...
def connection_status() -> tuple[bool, bool, bool]: ...

EventTupleRaw = tuple[str, int, Optional[bool], Optional[bool]]

class NativeWatcher:
    def __init__(self, callback: Callable[[EventTupleRaw], object]) -> None: ...
    def stop(self) -> None: ...
    @property
    def running(self) -> bool: ...

class NativeKeyboard:
    @staticmethod
    def open(mode: str = "auto") -> NativeKeyboard: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def connection(self) -> str: ...
    def firmware_version(self) -> int: ...
    def battery(self) -> Optional[tuple[int, bool]]: ...
    def is_linked(self) -> bool: ...
    def set_effect(self, name: str, brightness: int, speed: int, color: int) -> None: ...
    def lighting(self) -> tuple[Optional[str], int, int, int]: ...
    def lights_off(self) -> None: ...
    def set_effect_color(self, name: str, index: int, color: Rgb) -> None: ...
    def effect_palette(self, name: str) -> list[Rgb]: ...
    def per_key_colors(self) -> list[tuple[str, Rgb]]: ...
    def set_per_key_colors(self, colors: list[tuple[str, Rgb]]) -> None: ...
    def key_action(self, layer: int, name: str) -> ActionDict: ...
    def layer(self, layer: int) -> list[tuple[str, ActionDict]]: ...
    def remap_key(self, layer: int, name: str, action: ActionDict) -> None: ...
    def macros(self) -> list[MacroTuple]: ...
    def save_macros(self, macros: list[MacroTuple], on_progress: Optional[Callable[[int], object]] = None) -> None: ...
    def clear_macros(self) -> None: ...
    def debounce(self) -> int: ...
    def set_debounce(self, stage: int) -> None: ...
    def tap(self) -> Optional[int]: ...
    def set_tap(self, sensitivity: Optional[int]) -> None: ...
    def sleep_timeout(self) -> Optional[int]: ...
    def set_sleep_timeout(self, secs: Optional[int]) -> None: ...
    def send_frame(self, colors: list[tuple[str, Rgb]], lossy: bool = False) -> None: ...
    def stop_realtime(self) -> None: ...
    def factory_reset(self) -> None: ...
